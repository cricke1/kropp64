<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>se.konsiliet.server</string>
  <key>WorkingDirectory</key><string>/Users/sture/konsiliet/server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sture/.local/bin/uv</string><string>run</string><string>uvicorn</string>
    <string>konsiliet.api:app</string><string>--host</string><string>0.0.0.0</string><string>--port</string><string>8790</string><string>--no-access-log</string><string>--no-proxy-headers</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>KONSILIET_HOSTAR</key><string>app.kropp64.se</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/sture/.konsiliet/server.log</string>
  <key>StandardErrorPath</key><string>/Users/sture/.konsiliet/server.log</string>
</dict>
</plist>
