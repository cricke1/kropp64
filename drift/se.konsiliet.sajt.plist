<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Landningssidan kropp64.se: statiska filer från site/dist (bygg med site/bygg.sh) på 127.0.0.1:8796.
     Nås utifrån först när tunnelns publika värdnamn kropp64.se pekar på http://localhost:8796. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>se.konsiliet.sajt</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string><string>-m</string><string>http.server</string><string>8796</string>
    <string>--bind</string><string>127.0.0.1</string><string>--directory</string><string>/Users/sture/konsiliet/site/dist</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/sture/.konsiliet/sajt.log</string>
  <key>StandardErrorPath</key><string>/Users/sture/.konsiliet/sajt.log</string>
</dict>
</plist>
